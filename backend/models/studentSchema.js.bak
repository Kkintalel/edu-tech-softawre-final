const mongoose = require('mongoose');

const studentSchema = new mongoose.Schema({
    name: {
        type: String,
        required: true
    },
    admissionNo: {
        type: String,
        required: true,
        trim: true,
        unique: true,
        sparse: true
    },
    email: {
        type: String,
        default: '',
        unique: true,
        sparse: true,
        lowercase: true,
        trim: true
    },
    rollNum: {
        type: Number,
        required: true
    },
    photo: {
        type: String,
        default: ''
    },
    parentName: {
        type: String,
        default: ''
    },
    parentPhone: {
        type: String,
        default: ''
    },
    parentEmail: {
        type: String,
        default: ''
    },
    guardianName: {
        type: String,
        default: ''
    },
    guardianPhone: {
        type: String,
        default: ''
    },
    guardianEmail: {
        type: String,
        default: '',
        lowercase: true,
        trim: true
    },
    guardianRelation: {
        type: String,
        default: ''
    },
    password: {
        type: String,
        required: true
    },
    forcePasswordChange: {
        type: Boolean,
        default: false
    },
    sclassName: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'sclass',
        required: true,
    },
    school: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'admin',
        required: true,
    },
    role: {
        type: String,
        default: "Student"
    },
    totalFees: {
        type: Number,
        default: 0
    },
    amountPaid: {
        type: Number,
        default: 0
    },
    balance: {
        type: Number,
        default: 0
    },
    paymentStatus: {
        type: String,
        enum: ['Pending', 'Completed', 'Failed', 'Verified'],
        default: 'Pending'
    },
    paymentHistory: {
        type: [{
            amount: { type: Number, required: true },
            paymentMethod: { type: String, enum: ['Paybill', 'Card', 'Bank Transfer', 'Cash', 'Account Number', 'Online Transfer', 'Mpesa', 'M-Pesa STK Push'], default: 'Paybill' },
            date: { type: Date, default: Date.now },
            receiptNumber: { type: String, required: true },
            status: { type: String, enum: ['Pending', 'Completed', 'Failed', 'Verified'], default: 'Pending' },
            transactionId: { type: String, default: '' },
            balanceAfter: { type: Number, required: true },
            verifiedBy: { type: String, default: '' },
            verifiedDate: { type: Date, default: null },
            provider: { type: String, default: '' },
            reference: { type: String, default: '' }
        }],
        default: []
    },
    resetPasswordToken: {
        type: String,
        default: ''
    },
    resetPasswordExpires: {
        type: Date,
        default: null
    },
    examResult: [
        {
            subName: {
                type: mongoose.Schema.Types.ObjectId,
                ref: 'subject',
            },
            examType: {
                type: String,
                enum: ['CAT', 'END_TERM'],
                default: 'CAT'
            },
            marksObtained: {
                type: Number,
                default: 0
            },
            grade: {
                type: String,
                default: ''
            },
            level: {
                type: String,
                default: ''
            },
            points: {
                type: Number,
                default: 0
            },
            remark: {
                type: String,
                default: ''
            }
        }
    ],
    attendance: [{
        date: {
            type: Date,
            required: true,
            index: true
        },
        status: {
            type: String,
            enum: ['Present', 'Absent'],
            required: true
        },
        subName: {
            type: mongoose.Schema.Types.ObjectId,
            ref: 'subject',
            required: true,
            index: true
        }
    }]
});
studentSchema.index({ school: 1, admissionNo: 1 }, { unique: true });
studentSchema.index({ school: 1, sclassName: 1, rollNum: 1 }, { unique: true });
studentSchema.index({ school: 1, email: 1 }, { unique: true, sparse: true });
studentSchema.index({ 'attendance.subName': 1, 'attendance.date': 1 });
module.exports = mongoose.model("student", studentSchema);