# MongoDB connection string
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/schoolManagementSystem?retryWrites=true&w=majority

# Backend server
PORT=5000

# JWT / secret key
SECRET_KEY=<generate-a-long-random-secret>

# SMTP email settings for password resets and notifications
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_USER=edutech@edutechnologies.ac.ke
EMAIL_PASS=your-email-password
EMAIL_FROM=edutech@edutechnologies.ac.ke

# Frontend URL for reset links
FRONTEND_URL=http://localhost:3000

# Optional Twilio SMS settings
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# M-Pesa STK Push settings
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORTCODE=your_paybill_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-production-domain.com/Payment/MpesaCallback
